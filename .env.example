# ---- Database (Neon Postgres, free tier) ----
# Create a project at https://neon.tech, copy the pooled connection string.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# ---- Auth (single owner account, no external service) ----
NEXTAUTH_SECRET="generate-with: npx auth secret"
OWNER_EMAIL="you@example.com"
# Set ONE of these two — OWNER_PASSWORD takes priority if both are set.
# OWNER_PASSWORD: plain text, simplest option.
OWNER_PASSWORD=""
# OWNER_PASSWORD_HASH: bcrypt hash, if you'd rather not keep a plain
# password in your env vars. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
OWNER_PASSWORD_HASH=""

# ---- Cloudflare R2 (large raw documents: pdf/docx/xlsx/md, 50MB+) ----
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# ---- Cloudinary (images/video rendering) ----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Background jobs (Inngest, free tier) ----
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# ---- Obsidian one-way sync (optional — PLAN.md §8) ----
# Reads a notes/ folder from a GitHub repo (your Obsidian vault, pushed via
# the Obsidian Git plugin or any git workflow) and syncs .md files in as
# notes. A fine-grained PAT with read-only "Contents" access to that one
# repo is enough — https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=""
GITHUB_OBSIDIAN_REPO="" # "owner/repo"
GITHUB_OBSIDIAN_BRANCH="main"
GITHUB_OBSIDIAN_PATH="notes"
# Shared secret for the GitHub push webhook at /api/obsidian-webhook.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_WEBHOOK_SECRET=""

# ---- AI providers (model registry: src/lib/ai/models.ts) ----
# Everything AI-related — the AI Assist panel, translate, summarize, tag
# suggestions — runs through src/lib/ai/tasks.ts, which resolves whichever
# model was requested via src/lib/ai/providers.ts.
#
# FOR NOW, local is the ONLY registered model — every other provider was
# deliberately removed from models.ts/providers.ts/package.json per
# explicit instruction, not just deprioritized in a fallback chain. That
# means these three vars below are REQUIRED, not optional: if they're
# unset or the Mac/Funnel is unreachable, every AI feature in the app is
# down with no fallback. See "local API deployment.md". Create a key on
# the Mac with:
#   venv/bin/python3 keys_admin.py create brainbank --scope chat,tools --rate 60
# Must include the :8443 port — that's what distinguishes agent-server from
# the legacy gateway.py bridge (bare domain, no port).
LOCAL_LLM_FUNNEL_URL=""
LOCAL_LLM_SHARED_SECRET=""
# Model tag sent to agent-server; defaults to "qwen3.6:35b-a3b" if unset.
LOCAL_LLM_MODEL=""

# Google Gemini API — powers google/gemini-2.5-flash-lite, the fallback
# chain's commercial last resort (see models.ts's header comment). Required
# for that final fallback step to work; the two local models ahead of it in
# FALLBACK_CHAIN don't need this and keep working without it.
# https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""

# ---- Other providers (currently unused — removed from the model
# registry, see models.ts's header comment). Re-adding one is: a provider
# factory in providers.ts, a MODELS entry in models.ts, a line in
# FALLBACK_CHAIN, and the matching key below. Left here so re-enabling
# doesn't mean re-deriving these from scratch. ----

# Groq - free tier, ultra-fast Llama/Gemma/Compound models
# https://console.groq.com/keys
GROQ_API_KEY=""

# Anthropic - paid, Claude Sonnet/Opus/Haiku
ANTHROPIC_API_KEY=""

# DeepL - dedicated translation API, optional alternative to LLM translate
DEEPL_API_KEY=""
